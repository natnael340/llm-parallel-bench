.qodo
.venv
.env
.vscode/

# Build output dirs
obj/
bin/
target/
# ...but the Rust harness keeps its cargo [[bin]] targets in src/bin/, which
# the rule above would otherwise exclude from the repo entirely.
!bench/rust/src/bin/

# Java bytecode
*.class

# Python cache
__pycache__/
*.pyc
*.pyo

# MSBuild artifacts
*.FileListAbsolute.txt
*.AssemblyInfoInputs.cache
*.assets.cache
*.CoreCompileInputs.cache

# Benchmark harness: staging dirs, build outputs, and generated Rust modules
tests/**/staging/
bench/build/
bench/rust/target/
bench/rust/src/staged/

# Live benchmark results: overwritten by every run. Each run's copy is kept in
# results/runs/<unix epoch>/, which is what gets committed.
results/bfs/
results/gemm/
results/sccs/
results/smith-waterman/
results/failures.json
results/run_meta.json
