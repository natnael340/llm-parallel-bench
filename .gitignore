.qodo
.venv
.env
.vscode/

# Build output dirs
obj/
bin/
target/
# ...but the Rust harness keeps its cargo [[bin]] targets in src/bin/, which
# the rule above would otherwise exclude from the repo entirely.
!bench/rust/src/bin/

# Java bytecode
*.class

# Python cache
__pycache__/
*.pyc
*.pyo

# MSBuild artifacts
*.FileListAbsolute.txt
*.AssemblyInfoInputs.cache
*.assets.cache
*.CoreCompileInputs.cache

# Benchmark harness: staging dirs, build outputs, and generated Rust modules
tests/**/staging/
bench/build/
bench/rust/target/
bench/rust/src/staged/
