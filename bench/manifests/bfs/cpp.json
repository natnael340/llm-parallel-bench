{
  "algo": "bfs",
  "lang": "cpp",
  "harness": "tests/bfs/cpp",
  "harness_sources": ["test_bfs.cpp"],
  "compile_staged_sources": true,
  "default_reps": 5,
  "default_iters": 20,
  "params": { "graph_size": 2000, "graph_kind": "complete" },
  "canonical_entry": "bench_bfs(Graph&, int) -> std::vector<int>; Graph",
  "variants": {
    "baseline/seq": {
      "root": "baselines/bfs/cpp",
      "files": ["graph.h", "graph.cpp", "bfs_seq.hpp", "bfs_seq.cpp"],
      "adapter": [
        "#include <vector>",
        "#include \"graph.h\"",
        "#include \"bfs_seq.hpp\"",
        "inline std::vector<int> bench_bfs(Graph& g, int start_vertex) { return bfs(g, start_vertex); }"
      ]
    },
    "gpt-5/par": {
      "root": "llm_written/gpt-5/bfs/cpp",
      "files": ["graph.h", "graph.cpp", "bfs_parallel.hpp", "bfs_parallel.cpp", "bfs_seq.hpp", "bfs_seq.cpp"],
      "cxxflags": ["-fopenmp"],
      "adapter": [
        "#include <vector>",
        "#include \"graph.h\"",
        "#include \"bfs_parallel.hpp\"",
        "inline std::vector<int> bench_bfs(Graph& g, int start_vertex) { return bfs(g, start_vertex); }"
      ]
    },
    "claude-sonnet-4-5/par": {
      "root": "llm_written/claude-sonnet-4-5/bfs/cpp",
      "files": ["graph.h", "graph.cpp", "bfs_parallel.hpp", "bfs_parallel.cpp"],
      "cxxflags": ["-fopenmp"],
      "adapter": [
        "#include <vector>",
        "#include \"graph.h\"",
        "#include \"bfs_parallel.hpp\"",
        "inline std::vector<int> bench_bfs(Graph& g, int start_vertex) { return bfs_parallel(g, start_vertex); }"
      ]
    },
    "gemini-2-5-pro/par": {
      "root": "llm_written/gemini-2-5-pro/bfs/cpp",
      "files": ["graph.h", "graph.cpp", "bfs_parallel.hpp", "bfs_parallel.cpp", "bfs_seq.hpp", "bfs_seq.cpp"],
      "cxxflags": ["-fopenmp"],
      "adapter": [
        "#include <vector>",
        "#include \"graph.h\"",
        "#include \"bfs_parallel.hpp\"",
        "inline std::vector<int> bench_bfs(Graph& g, int start_vertex) { return bfs_parallel(g, start_vertex); }"
      ]
    }
  }
}
