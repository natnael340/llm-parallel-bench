<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>llm_parallel_bench</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude all .cs files in subdirectories -->
    <Compile Remove="**\*.cs" />
    <!-- Re-include only files in the root folder -->
    <Compile Include="scc/C#/*.cs" />
  </ItemGroup>

</Project>
